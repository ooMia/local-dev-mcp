# 아래 조회 명령은 사용자가 로컬 CLI에서 실행한다. 실제 값·키를 Chat에 붙여 넣지 않는다.
# 의미·권한·우선순위·실패 계약: docs/configuration.md
# 설정 변경 후 connect/run을 재시작한다.

# connect 필수. Platform Tunnels에서 대상을 확인한다:
# https://platform.openai.com/settings/organization/tunnels
# 기존 admin 권한이 있을 때만 CLI로 ID 목록을 확인할 수 있다:
# tunnel-client admin tunnels list --organization-id <ORG_ID>
# 일반 runtime을 위해 admin key를 새로 준비할 필요는 없다.
CONTROL_PLANE_TUNNEL_ID=

# connect 필수. Restricted key를 발급하고 Tunnels Read+Use를 허용한다:
# https://platform.openai.com/settings/organization/api-keys
# 확인한 CLI에는 runtime key 발급·기존 secret 복구 명령이 없다.
# 실제 값은 이 예시를 복사한 .env에만 작성한다.
CONTROL_PLANE_API_KEY=

# 선택: host gh Keychain 접근이 안 되는 headless Tunnel의 GitHub CLI 인증.
# 권장: 같은 셸에서 export GH_TOKEN="$(gh auth token --hostname github.com)" 후 connect 실행.
# 또는 gitignored .env에 GH_TOKEN을 직접 설정할 수 있다(.env 값이 셸 값보다 우선).
# 토큰 값은 Chat/로그/CLI 인자에 전달하지 않는다. GITHUB_TOKEN은 전달하지 않는다.
# GH_TOKEN을 설정하면 Tunnel/MCP/gh 자식 프로세스 환경에도 포함된다.
# 정적 토큰은 자동 갱신되지 않으며, Git push의 HTTPS/SSH 인증은 별도다.
GH_TOKEN=

# commit 필수. 누락·무효이면 commit만 사용 불가이며 다른 Git 작업은 가능하다.
# 기존 설정을 확인한 뒤 사용할 이름·이메일을 선택해 복사한다:
# git config get user.name
# git config get user.email
# 기존 값이 없으면 직접 정한다. Git 설정을 수정할 필요는 없다.
GIT_USER_NAME=
GIT_USER_EMAIL=

# 선택. true/false만 허용하며 생략 시 false(unsigned)다.
# true이면 아래 OpenPGP 설정과 config.toml의 gpg 허용이 필요하다.
GIT_COMMIT_SIGN=false

# 선택. 서명 true에서 선택 override. 생략·빈 값이면 같은 GnuPG 설치의 기본 홈을 탐색한다.
# 기본 홈 확인: gpgconf --list-dirs homedir
# 별도 키 저장소를 고정하려면 실제 절대 경로를 적는다. 변수 이름만 쓰는 선언은 무효다.
GIT_GPG_HOME=

# 선택. 그러나 GIT_COMMIT_SIGN=true에서 필수.
# <HOME>을 명시 경로 또는 조회한 기본 홈으로 바꿔 키 목록을 확인한다:
# gpg --homedir "<HOME>" --with-subkey-fingerprint --list-secret-keys
# 사용할 키의 full fingerprint(40/64자리 hex)를 선택한다. 정확한 primary/subkey 지정은 끝에 !를 붙인다.
# git config get user.signingkey도 참고할 수 있으나 짧은 ID·이메일이면 그대로 사용할 수 없다.
# 개인키 본문·passphrase는 넣지 않는다.
GIT_SIGNING_KEY=

# 선택. 서명 true에서 선택 override. gpg 실행 파일 위치 확인: command -v gpg
# 고정하려면 절대 경로를 적는다. 생략·빈 값이면 시작 시 PATH에서 탐색한다.
GIT_GPG_PROGRAM=

# 호스트 권한·공유 daemon·비대화형 키 사용 조건: docs/configuration.md#서명-기능과-내부-의존성

# 선택적 Trail Code 구조 인덱스 관리. 먼저 config.toml [system].allowed_commands에 "trail" 허용.
# TRAIL_EXECUTABLE을 생략하면 서버 프로세스의 PATH에서 trail을 검색한다 (shutil.which).
# PATH 조회는 서버 시작 환경을 기준으로 한다. 서비스 PATH가 다르면 절대 경로를 지정한다.
# 빈 TRAIL_EXECUTABLE=은 생략과 다르므로, PATH 검색을 원하면 주석 상태로 둔다.
# TRAIL_EXECUTABLE=/absolute/path/to/trail
#
# 기본값 false: 상태 조회와 수동 갱신만 수행. true를 명시한 경우에만 자동 갱신.
# Trail 미설치·권한 미허용 환경에서는 기존 파일·Git 도구가 그대로 작동한다.
# TRAIL_REFRESH_ON_WRITE=true
